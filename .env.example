# App runtime
NODE_ENV=production
PORT=8080

# CORS
# For public SPA + same-domain backend you can keep "*".
CORS_ORIGIN=*

# Public API base URL used by frontend/backend where needed
API_BASE_URL=

# Future AI agent integration
AI_AGENT_ENDPOINT=
AI_AGENT_MODEL=
# Keep secrets in Secret Manager in production. Do not commit real keys.
AI_AGENT_API_KEY=
